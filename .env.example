# Box OAuth Configuration
# Get these from your Box Developer Console: https://developer.box.com/
VITE_BOX_CLIENT_ID=your_box_client_id_here
VITE_BOX_CLIENT_SECRET=your_box_client_secret_here
VITE_BOX_REDIRECT_URI=http://localhost:3000/auth/callback

# Anthropic API Configuration
# Get your API key from: https://console.anthropic.com/
VITE_ANTHROPIC_API_KEY=your_anthropic_api_key_here
VITE_ANTHROPIC_MODEL=claude-opus-4-1-20250805

# Box MCP Server Configuration (Optional)
# Only change if you have a deployed your Box MCP Server
# Details: https://developer.box.com/guides/box-mcp/
VITE_BOX_MCP_SERVER_URL=https://mcp.box.com

# Development Configuration (Optional)
VITE_DEBUG=false